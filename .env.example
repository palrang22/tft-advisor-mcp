# 복사해서 .env로 쓴다. 값이 비어 있으면 common/config.py 기본값을 쓴다.

# GCP
GCP_PROJECT=your-project-id
BQ_DATASET=tft
BQ_LOCATION=asia-northeast3

# OP.GG MCP (스냅샷 잡에서만 사용)
OPGG_MCP_URL=https://mcp-api.op.gg/mcp
OPGG_CLIENT_APP=tft-advisor-mcp-snapshot/0.1
OPGG_CALL_INTERVAL_SEC=1.0

# 세트 / 정적 데이터
TFT_SET=18
CDRAGON_URL=https://raw.communitydragon.org/latest/cdragon/tft/ko_kr.json

# 통계 기준값
LOW_SAMPLE_N=100
SMOOTHING_K=30

# 로컬 경로
SNAPSHOT_DIR=data/snapshots
CACHE_DIR=data/cache

# 서빙 (core / 어댑터)
DATA_BACKEND=bigquery           # bigquery | cache
SERVE_PORT=8080
API_KEY=                        # REST용 (Phase 8, 선택). 비우면 인증 없음
CORS_ORIGINS=http://localhost:3000
MCP_RATE_LIMIT_PER_MIN=60       # 원격 /mcp IP당 호출 제한

# 로깅 (stderr)
LOG_LEVEL=INFO

# Phase 11 (Riot 자체 수집, 보류)
# RIOT_API_KEY=
